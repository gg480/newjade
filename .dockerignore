# 依赖与构建产物（Dockerfile 内重新安装和构建）
node_modules
.next

# 版本控制
.git
.github

# 数据库文件（通过 volume 挂载，不打包进镜像）
db/custom.db
*.db
*.sqlite
*.sqlite3

# 测试文件
tests/

# 脚本（构建/部署脚本不需要进镜像）
scripts/

# 团队协作文件
.trae/

# 文档
*.md

# pnpm workspace（避免 docker 内被误识别为 monorepo）
pnpm-workspace.yaml

# 环境变量
.env
.env.*
!.env.example

# 日志
*.log
logs/

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode
.idea

# Docker 自身
Dockerfile
.dockerignore
docker-compose.yml
