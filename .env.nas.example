# ============================================================
# Jade ERP — NAS 部署环境变量
# 复制此文件为 .env 并修改配置
# ============================================================

# ── 镜像配置 ──
# 优先从阿里云 ACR 拉取（国内速度快）
# 格式：<registry>/<namespace>/<image>:<tag>
JADE_IMAGE=crpi-mhs13r1rv9emmqbi.cn-hangzhou.personal.cr.aliyuncs.com/jadeerp/jadeerp:latest
JADE_PORT=5000

# ── 数据目录（建议使用 NAS 绝对路径） ──
JADE_DB_DIR=/volumeSSD/jade/db
JADE_IMAGE_DIR=/volumeHDD/jade/images
JADE_LOG_DIR=/volumeSSD/jade/logs
JADE_BACKUP_DIR=/volumeSSD/jade/backups
JADE_CONFIG_DIR=/volumeSSD/jade/config

# ── 用户权限 ──
PUID=0
PGID=0
TZ=Asia/Shanghai

# ── Watchtower 自动更新配置 ──
# 检查间隔（秒），默认 21600 = 6 小时
# WATCHTOWER_INTERVAL=21600
# 如需定时检查而非间隔，取消注释下行（cron 格式，UTC 时间）
# WATCHTOWER_SCHEDULE=0 0 3 * * *

# ── 镜像仓库认证（Watchtower 拉取私有镜像需要） ──
# 如果使用私有仓库，取消注释并填写
# WATCHTOWER_REGISTRY_USER=your-username
# WATCHTOWER_REGISTRY_PASSWORD=your-password
